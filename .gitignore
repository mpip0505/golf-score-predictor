# Python virtual environment
venv/
.venv/

# Python caches / build artifacts
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/

# Streamlit
.streamlit/secrets.toml

# macOS
.DS_Store

# Editors
.vscode/
.idea/

# Personal round log (Phase 8+) - private data, never commit
data/my_rounds.csv

# Automatic backups of the round log (testing phase) - also private data
data/backups/
# Temp files from an interrupted atomic save (safe to delete). The save
# names them .my_rounds_XXXX.tmp; both patterns are listed to be explicit.
data/*.tmp
data/.*.tmp

# Practice-mode folders (ROUND_DATA_DIR=...) if you make one INSIDE the repo.
# Name it scratch/ or golf_scratch<anything>/ and git will ignore it.
scratch/
golf_scratch*/
